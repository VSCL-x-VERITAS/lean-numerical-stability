{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Round-trip source-versus-translation judgment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role", "task_id", "source_sha256", "blind_translation_sha256", "semantic_checklist", "implications", "classification", "accepted", "requires_adjudication", "findings", "rationale"],
  "properties": {
    "schema_version": {"const": "formalization-faithfulness-1"},
    "role": {"const": "roundtrip-judge"},
    "task_id": {"$ref": "#/$defs/taskId"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "blind_translation_sha256": {"$ref": "#/$defs/sha256"},
    "semantic_checklist": {"$ref": "#/$defs/semanticChecklist"},
    "implications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["translation_implies_source", "source_implies_translation"],
      "properties": {
        "translation_implies_source": {"$ref": "#/$defs/implication"},
        "source_implies_translation": {"$ref": "#/$defs/implication"}
      }
    },
    "classification": {"$ref": "#/$defs/classification"},
    "accepted": {"type": "boolean"},
    "requires_adjudication": {"type": "boolean"},
    "findings": {"$ref": "#/$defs/findings"},
    "rationale": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "taskId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "classification": {"enum": ["faithful-equivalent", "faithful-stronger", "not-faithful-weaker", "not-faithful-different", "undetermined"]},
    "implication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "reasoning"],
      "properties": {
        "verdict": {"enum": ["yes", "no", "unclear"]},
        "reasoning": {"type": "string", "minLength": 1}
      }
    },
    "semanticChecklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "source_evidence", "translation_evidence", "reasoning"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,15}$"},
          "status": {"enum": ["pass", "fail", "unclear", "not-applicable"]},
          "source_evidence": {"type": "string", "minLength": 1},
          "translation_evidence": {"type": "string", "minLength": 1},
          "reasoning": {"type": "string", "minLength": 1}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "category", "source_evidence", "translation_evidence", "impact"],
        "properties": {
          "severity": {"enum": ["critical", "major", "minor", "note"]},
          "category": {"type": "string", "minLength": 1},
          "source_evidence": {"type": "string", "minLength": 1},
          "translation_evidence": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
