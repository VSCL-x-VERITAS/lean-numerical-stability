{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Formalization faithfulness adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role", "task_id", "trigger", "resolved_items", "implications", "classification", "accepted", "remaining_uncertainties", "findings", "rationale"],
  "properties": {
    "schema_version": {"const": "formalization-faithfulness-1"},
    "role": {"const": "adjudicator"},
    "task_id": {"$ref": "#/$defs/taskId"},
    "trigger": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "resolved_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "resolution", "primary_evidence"],
        "properties": {
          "item": {"type": "string", "minLength": 1},
          "resolution": {"type": "string", "minLength": 1},
          "primary_evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "implications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lean_implies_source", "source_implies_lean"],
      "properties": {
        "lean_implies_source": {"$ref": "#/$defs/implication"},
        "source_implies_lean": {"$ref": "#/$defs/implication"}
      }
    },
    "classification": {"$ref": "#/$defs/classification"},
    "accepted": {"type": "boolean"},
    "remaining_uncertainties": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "category", "evidence", "impact"],
        "properties": {
          "severity": {"enum": ["critical", "major", "minor", "note"]},
          "category": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1}
        }
      }
    },
    "rationale": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "taskId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "classification": {"enum": ["faithful-equivalent", "faithful-stronger", "not-faithful-weaker", "not-faithful-different", "undetermined"]},
    "implication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "reasoning"],
      "properties": {
        "verdict": {"enum": ["yes", "no", "unclear"]},
        "reasoning": {"type": "string", "minLength": 1}
      }
    }
  }
}
