{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Direct source-versus-Lean judgment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role", "task_id", "source_sha256", "dossier_sha256", "dependency_coverage", "semantic_checklist", "implications", "classification", "accepted", "requires_adjudication", "findings", "rationale"],
  "properties": {
    "schema_version": {"const": "formalization-faithfulness-1"},
    "role": {"const": "direct-judge"},
    "task_id": {"$ref": "#/$defs/taskId"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "dossier_sha256": {"$ref": "#/$defs/sha256"},
    "dependency_coverage": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/reviewedDependency"}, {"$ref": "#/$defs/reusedDependency"}]}},
    "semantic_checklist": {"$ref": "#/$defs/semanticChecklist"},
    "implications": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lean_implies_source", "source_implies_lean"],
      "properties": {
        "lean_implies_source": {"$ref": "#/$defs/implication"},
        "source_implies_lean": {"$ref": "#/$defs/implication"}
      }
    },
    "classification": {"$ref": "#/$defs/classification"},
    "accepted": {"type": "boolean"},
    "requires_adjudication": {"type": "boolean"},
    "findings": {"$ref": "#/$defs/findings"},
    "rationale": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "taskId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "classification": {"enum": ["faithful-equivalent", "faithful-stronger", "not-faithful-weaker", "not-faithful-different", "undetermined"]},
    "implication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "reasoning"],
      "properties": {
        "verdict": {"enum": ["yes", "no", "unclear"]},
        "reasoning": {"type": "string", "minLength": 1}
      }
    },
    "reviewedDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "interpretation", "effect_on_target", "source_match", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^D[0-9]{3}$"},
        "name": {"type": "string", "minLength": 1},
        "interpretation": {"type": "string", "minLength": 1},
        "effect_on_target": {"type": "string", "minLength": 1},
        "source_match": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail", "unclear", "not-applicable"]}
      }
    },
    "reusedDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "reuse_sha256", "effect_on_target", "source_match", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^D[0-9]{3}$"},
        "name": {"type": "string", "minLength": 1},
        "reuse_sha256": {"$ref": "#/$defs/sha256"},
        "effect_on_target": {"type": "string", "minLength": 1},
        "source_match": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail", "unclear", "not-applicable"]}
      }
    },
    "semanticChecklist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "source_evidence", "lean_evidence", "reasoning"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,15}$"},
          "status": {"enum": ["pass", "fail", "unclear", "not-applicable"]},
          "source_evidence": {"type": "string", "minLength": 1},
          "lean_evidence": {"type": "string", "minLength": 1},
          "reasoning": {"type": "string", "minLength": 1}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "category", "source_evidence", "lean_evidence", "impact"],
        "properties": {
          "severity": {"enum": ["critical", "major", "minor", "note"]},
          "category": {"type": "string", "minLength": 1},
          "source_evidence": {"type": "string", "minLength": 1},
          "lean_evidence": {"type": "string", "minLength": 1},
          "impact": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
