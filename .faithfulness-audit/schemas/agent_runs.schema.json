{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit agent runtime provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "runs"],
  "properties": {
    "schema_version": {"const": "formalization-faithfulness-1"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "model", "reasoning_effort", "agent_id", "runtime", "started_at_utc", "completed_at_utc", "notes"],
        "properties": {
          "role": {"enum": ["source-contract", "batch-source-contract", "blind-translation", "direct-judge", "roundtrip-judge", "adjudicator"]},
          "model": {"type": ["string", "null"]},
          "reasoning_effort": {"type": ["string", "null"]},
          "agent_id": {"type": ["string", "null"]},
          "runtime": {"type": "string", "minLength": 1},
          "started_at_utc": {"type": ["string", "null"]},
          "completed_at_utc": {"type": "string", "minLength": 1},
          "notes": {"type": ["string", "null"]}
        }
      }
    }
  }
}
