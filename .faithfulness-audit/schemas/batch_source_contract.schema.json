{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Formalization batch source contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role", "source_group", "source_sha256", "source_locator_sha256", "task_ids", "contracts"],
  "properties": {
    "schema_version": {"const": "formalization-faithfulness-1"},
    "role": {"const": "batch-source-contract"},
    "source_group": {"type": "string", "minLength": 1},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "source_locator_sha256": {"$ref": "#/$defs/sha256"},
    "task_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/taskId"}},
    "contracts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contract"}}
  },
  "$defs": {
    "taskId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stringArray": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "nonemptyStringArray": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "anchor", "observation"],
      "properties": {
        "location": {"type": "string", "minLength": 1},
        "anchor": {"type": "string", "minLength": 1},
        "observation": {"type": "string", "minLength": 1}
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "evidence", "impact"],
      "properties": {
        "issue": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1}
      }
    },
    "facet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "details"],
      "properties": {
        "topic": {"type": "string", "minLength": 1},
        "details": {"$ref": "#/$defs/nonemptyStringArray"}
      }
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binders", "hypotheses", "conclusions", "definitions_and_conventions", "implicit_context", "semantic_facets"],
      "properties": {
        "binders": {"$ref": "#/$defs/stringArray"},
        "hypotheses": {"$ref": "#/$defs/stringArray"},
        "conclusions": {"$ref": "#/$defs/nonemptyStringArray"},
        "definitions_and_conventions": {"$ref": "#/$defs/stringArray"},
        "implicit_context": {"$ref": "#/$defs/stringArray"},
        "semantic_facets": {"type": "array", "items": {"$ref": "#/$defs/facet"}}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "source_evidence", "statement", "undebatable_constraints", "ambiguities", "contract_plain_english"],
      "properties": {
        "task_id": {"$ref": "#/$defs/taskId"},
        "source_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "statement": {"$ref": "#/$defs/statement"},
        "undebatable_constraints": {"$ref": "#/$defs/nonemptyStringArray"},
        "ambiguities": {"type": "array", "items": {"$ref": "#/$defs/ambiguity"}},
        "contract_plain_english": {"type": "string", "minLength": 1}
      }
    }
  }
}
