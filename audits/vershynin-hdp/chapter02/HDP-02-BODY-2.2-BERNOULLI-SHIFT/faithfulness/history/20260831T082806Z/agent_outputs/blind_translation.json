  "translation": {
    "binders": [
      "μ ranges over all Borel measures on ℝ."
    ],
    "hypotheses": [],
    "conclusions": [
      "If the pushforward of μ by x ↦ 2x - 1 is the equal-weight measure on {-1,1}, then μ is the equal-weight measure on {0,1}.",
      "Conversely, the equal-weight measure on {0,1} pushes forward under x ↦ 2x - 1 to the equal-weight measure on {-1,1}."
    ],
    "mathematical_definitions": [
      "T(x) = 2x - 1.",
      "ν₀₁ = (1/2)δ₀ + (1/2)δ₁.",
      "ν₋₁,₁ = (1/2)δ₋₁ + (1/2)δ₁."
    ],
    "proposition_plain_english": "For every Borel measure μ on ℝ, T₍*₎μ = (1/2)δ₋₁ + (1/2)δ₁ if and only if μ = (1/2)δ₀ + (1/2)δ₁, where T(x) = 2x - 1."
  },
  "restrictions_and_vacuity_risks": [
    "The measurable structure on ℝ is Borel.",
    "μ is arbitrary, not initially assumed to be a probability measure.",
    "The conclusion concerns exact equality of measures.",
    "No ambient probability space, random variable, independence, or almost-sure claim is encoded.",
    "The numeral and inequality proofs are construction data, not assumptions.",
    "There is no implication-vacuity issue."
  ],
  "ambiguities": []
}
